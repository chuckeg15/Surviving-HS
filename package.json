{
  "name": "candlewake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CANDLEWAKE - a top-down sci-fi mystery RPG",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:reach && npm run test:polish && npm run test:progression && npm run test:e2e",
    "test:e2e": "node tests/e2e/run.mjs",
    "shots": "node tools/capture.mjs",
    "test:audio": "node tools/audiocheck.mjs",
    "test:reach": "node tools/reachability.mjs",
    "test:progression": "node tools/progression.mjs",
    "test:balance": "node tools/balance.mjs",
    "test:polish": "node tools/polish.mjs",
    "test:composition": "node tools/composition.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
