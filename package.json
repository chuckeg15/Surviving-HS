{
  "name": "candlewake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CANDLEWAKE - a top-down sci-fi mystery RPG",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "shots": "node tools/capture.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
